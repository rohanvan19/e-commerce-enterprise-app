APP_MODE=local
# PostgreSQL 17+. Never commit real passwords.
DATABASE_URL=postgresql://cocoa:replace-with-your-password@127.0.0.1:55432/cocoa_local
DATABASE_POOL_MAX=10
DATABASE_SCHEMA=public
# Use a direct/session PostgreSQL endpoint for LISTEN when DATABASE_URL uses a transaction pooler.
# DATABASE_LISTEN_URL=
# Separate DDL-capable credential for the migration CLI; runtime can use a restricted role.
# DATABASE_MIGRATION_URL=
# PEM CA file for managed PostgreSQL with a private CA. Remote TLS verification is mandatory.
# DATABASE_SSL_CA=
# Optional separate database for integration tests. Each run creates/drops only its own random schema.
# TEST_DATABASE_URL=
# Optional initial owner (used only by db:seed on a new store).
# ADMIN_EMAIL=admin@cocoalocal.test
# ADMIN_PASSWORD=use-a-unique-long-passphrase
# Without ADMIN_PASSWORD, local db:seed writes .local-access.json.
